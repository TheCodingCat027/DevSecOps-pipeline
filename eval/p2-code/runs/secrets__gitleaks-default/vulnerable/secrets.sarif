{
  "version": "2.1.0",
  "$schema": "https://schemastore.azurewebsites.net/schemas/json/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "gitleaks",
          "version": "8.30.1",
          "informationUri": "https://github.com/gitleaks/gitleaks",
          "rules": [
            {
              "id": "aws-access-token",
              "shortDescription": {
                "text": "Identified a pattern that may indicate AWS credentials, risking unauthorized cloud resource access and data breaches on AWS platforms."
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "aws-access-token",
          "level": "error",
          "message": {
            "text": "Identified a pattern that may indicate AWS credentials, risking unauthorized cloud resource access and data breaches on AWS platforms (aws-access-token) detected at demo-app/vulnerable/config.py:17. The secret value is redacted from this report."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "demo-app/vulnerable/config.py"
                },
                "region": {
                  "startLine": 17
                }
              }
            }
          ],
          "properties": {
            "severity": "Critical",
            "category": "secret",
            "raw_severity": "aws-access-token",
            "fix": "Rotate the credential immediately, remove it from the source and from git history (e.g. git filter-repo), and load it from a secrets manager or an environment variable.",
            "confidence": "high"
          }
        }
      ]
    }
  ]
}
