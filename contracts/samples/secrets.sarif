{
  "version": "2.1.0",
  "$schema": "https://schemastore.azurewebsites.net/schemas/json/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "gitleaks",
          "version": "8.18.4",
          "informationUri": "https://github.com/gitleaks/gitleaks",
          "rules": [
            {
              "id": "aws-access-token",
              "shortDescription": {
                "text": "AWS Access Token detected"
              },
              "helpUri": "https://docs.aws.amazon.com/general/latest/gr/aws-access-keys-best-practices.html"
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "aws-access-token",
          "level": "error",
          "message": {
            "text": "Detected a hard-coded AWS access key ID. This is a critical secret that grants AWS API access."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "demo-app/vulnerable/config.py"
                },
                "region": {
                  "startLine": 5
                }
              }
            }
          ],
          "properties": {
            "severity": "Critical",
            "category": "secret",
            "raw_severity": "aws-access-token",
            "fix": "Remove the hard-coded key and read credentials from environment variables or a secrets manager.",
            "confidence": "high"
          }
        },
        {
          "ruleId": "aws-secret-access-key",
          "level": "error",
          "message": {
            "text": "Detected a hard-coded AWS secret access key. This should never be stored in source code."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "demo-app/vulnerable/config.py"
                },
                "region": {
                  "startLine": 6
                }
              }
            }
          ],
          "properties": {
            "severity": "Critical",
            "category": "secret",
            "raw_severity": "aws-secret-access-key",
            "fix": "Remove the hard-coded secret and read credentials from environment variables or a secrets manager.",
            "confidence": "high"
          }
        }
      ]
    }
  ]
}
