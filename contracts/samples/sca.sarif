{
  "version": "2.1.0",
  "$schema": "https://schemastore.azurewebsites.net/schemas/json/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "trivy",
          "version": "0.51.4",
          "informationUri": "https://trivy.dev",
          "rules": [
            {
              "id": "CVE-2024-34064",
              "shortDescription": {
                "text": "Jinja2: Cross-Site Scripting (XSS) via xmlattr filter"
              }
            },
            {
              "id": "CVE-2023-30861",
              "shortDescription": {
                "text": "Flask: Session cookie without Secure flag served over HTTP"
              }
            },
            {
              "id": "CVE-2023-25577",
              "shortDescription": {
                "text": "Werkzeug: multipart data parsing vulnerability"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "CVE-2024-34064",
          "level": "warning",
          "message": {
            "text": "Jinja2 2.11.3 is vulnerable to XSS via the xmlattr filter. An attacker can inject arbitrary HTML/JavaScript into rendered templates."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "demo-app/vulnerable/requirements.txt"
                },
                "region": {
                  "startLine": 2
                }
              }
            }
          ],
          "properties": {
            "severity": "Medium",
            "category": "sca",
            "raw_severity": "MEDIUM",
            "cve_id": "CVE-2024-34064",
            "package": "Jinja2",
            "installed_version": "2.11.3",
            "fixed_version": "3.1.4",
            "fix_available": true,
            "fix": "Upgrade Jinja2 to >= 3.1.4"
          }
        },
        {
          "ruleId": "CVE-2023-30861",
          "level": "warning",
          "message": {
            "text": "Flask 1.1.4 sends session cookies without the Secure flag over HTTP connections, potentially exposing session tokens."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "demo-app/vulnerable/requirements.txt"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ],
          "properties": {
            "severity": "High",
            "category": "sca",
            "raw_severity": "HIGH",
            "cve_id": "CVE-2023-30861",
            "package": "Flask",
            "installed_version": "1.1.4",
            "fixed_version": "2.3.2",
            "fix_available": true,
            "fix": "Upgrade Flask to >= 2.3.2"
          }
        },
        {
          "ruleId": "CVE-2023-25577",
          "level": "warning",
          "message": {
            "text": "Werkzeug 1.0.1 is vulnerable to a multipart data parsing DoS. An attacker can craft a request that consumes excessive memory."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "demo-app/vulnerable/requirements.txt"
                },
                "region": {
                  "startLine": 3
                }
              }
            }
          ],
          "properties": {
            "severity": "High",
            "category": "sca",
            "raw_severity": "HIGH",
            "cve_id": "CVE-2023-25577",
            "package": "Werkzeug",
            "installed_version": "1.0.1",
            "fixed_version": "2.2.3",
            "fix_available": true,
            "fix": "Upgrade Werkzeug to >= 2.2.3"
          }
        }
      ]
    }
  ]
}
