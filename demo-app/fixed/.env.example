# Environment variables for the FIXED demo app
# Copy this file to .env and fill in real values ONLY in a local dev environment.
# NEVER commit .env to version control.
# Use a secrets manager (e.g. AWS Secrets Manager, HashiCorp Vault) in production.

# Required: Flask secret key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=replace-with-a-random-secret-key

# Optional: AWS credentials (only needed if using S3 features)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
S3_BUCKET=your-bucket-name

# Optional: Database path (defaults to demo.db in the working directory)
DATABASE_PATH=demo.db

# Optional: Enable debug mode in development only (never in production)
FLASK_DEBUG=false
